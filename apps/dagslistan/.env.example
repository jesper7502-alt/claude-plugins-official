# Kopiera till .env.local och fyll i från Firebase-konsolen:
# Projektinställningar → Allmänt → Dina appar → Webbapp → SDK-konfiguration.
# Värdena är inte hemliga (de hamnar i sidans kod); skyddet sköts av firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
